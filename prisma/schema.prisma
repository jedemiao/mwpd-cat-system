// MWPD Communication & Activity Tracker — database schema
// Every core table carries officeId so the same schema supports
// one division today and many offices sharing one instance later.
// Pair officeId with Postgres Row-Level Security policies in production
// (see README) so office A can never query office B's rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // full system access, manages offices/users
  DIVISION_CHIEF // approves, signs off, sees all division data
  RECORDS_STAFF // ADAS III / intake & filing (Incoming/Outgoing entry)
  STAFF // field staff, logs activities, requests leave
}

enum DocComplexity {
  SIMPLE // ARTA: 3 working days
  COMPLEX // ARTA: 7 working days
  HIGHLY_TECHNICAL // ARTA: 20 working days
}

// Where a document came from. The source tracker splits these into two
// separate pages and two near-identical ledgers; here it is one field on one
// ledger, so the distinction is filterable without duplicating the module.
// Where a document came from, read from the receiving division's side.
//
// The offices split their Incoming ledger on this, and they mean "did we write
// this ourselves, or did it come to us from somewhere else" — so a document
// forwarded by another DMW division is EXTERNAL to the division receiving it,
// and lands in Incoming > External alongside agency and walk-in correspondence.
// This contradicts an earlier reading of the enum (that INTERNAL covered other
// divisions); confirmed with the office 2026-09-08, and
// /api/deliveries/[id]/receive files hand-overs as EXTERNAL accordingly.
enum DocumentOrigin {
  INTERNAL // this division's own paperwork
  EXTERNAL // anything that reached us from elsewhere — other DMW divisions,
  //          agencies, employers, walk-in clients, email
}

// The office's own vocabulary for what a day on the calendar is, taken from
// the source tracker's "Legend" dropdown. One category per activity.
//
// Their legend has a tenth entry, "On Leave", which is deliberately NOT a
// value here. They have no Leave module, so leave is filed as an activity with
// Legend = On Leave and the person's name typed in free text. We have a real
// Leave model, so leave is *projected* onto the calendar from that table at
// render time. Leaving ON_LEAVE out of the enum means the API cannot accept it
// either — the Leave module stays the only place a leave can be created, and
// there is exactly one source of truth for who is out.
enum ActivityCategory {
  INSPECTION
  QUICK_RESPONSE_TEAM
  CONFERENCE_TRAINING
  MEETINGS
  SKELETON_FORCE
  PUBLIC_HOLIDAY
  OTHERS
}

// Which half of the year a D/IPCR covers. The office prepares one sheet per
// semester ("D/IPCR 2ND SEM"), and the six month columns on it are the months
// of that half — so the semester decides which months the matrix shows.
enum DipcrSemester {
  FIRST // January–June
  SECOND // July–December
}

enum LeaveType {
  CTO
  VACATION
  SICK
  EMERGENCY
  OTHER
}

// Where a reply (or an originated dispatch) has got to on its way out of the
// office. Every routed incoming document is worked into a reply, and that reply
// is checked by the Division Chief before it leaves — so a dispatch record now
// exists for most of its life *before* anything is released.
//
// The register at /outgoing?view=released shows RELEASED rows only. Everything
// earlier is work in progress and belongs on the work board, not in a register
// whose every row is meant to be a document that really left the building.
enum OutgoingStatus {
  DRAFT // being written; not yet submitted to the Chief
  FOR_CHECKING // submitted, sitting with the Chief
  RETURNED // the Chief sent it back for revision
  APPROVED // the Chief is satisfied; not yet physically released
  RELEASED // out the door, tracking number assigned
}

// How the Division Chief answered one submission. Stored per version rather
// than per document: a reply that went back twice has two RETURNED rounds and
// one APPROVED one, and the point of versioning is that all three stay readable.
enum OutgoingReviewOutcome {
  RETURNED
  APPROVED
}

model Office {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // short code, e.g. "MWPTD"
  createdAt DateTime @default(now())

  // Whether this office is subject to ARTA (Anti-Red Tape Act) due dates.
  // Only MWPTD is — the other divisions and ORD are exempt, so due-date
  // alerts, the nav badge and the dashboard's compliance board are all
  // meaningless noise for them.
  //
  // Defaults to false so a division onboarded later is exempt unless someone
  // deliberately opts it in: wrongly showing an office overdue-document alerts
  // it has no duty to act on is worse than wrongly showing none, and the
  // second mistake is the one anybody would notice.
  tracksArta Boolean @default(false)

  // Whether a dispatch needs the Division Chief's approval before it can be
  // released. MWPTD works that way — draft, submit, Chief approves, release —
  // and the review flow exists for them. The other divisions release directly:
  // their staff put the document out themselves, and a gate none of them asked
  // for would just stop work.
  //
  // Defaults to TRUE, unlike the tracksX flags, and deliberately: those decide
  // whether an office SEES something, where over-showing is the cheap mistake.
  // This decides whether a document can leave the office unreviewed, where the
  // cheap mistake is the other way round. A division onboarded later gets the
  // gate until somebody consciously removes it.
  requiresChiefApproval Boolean @default(true)

  // Whether the incoming and outgoing ledgers render this office's full
  // register layout, copied column-for-column from MWPSD's own tracker.
  // Everyone else keeps the compact ledgers, which fit a printed sheet where
  // the register layouts do not.
  //
  // One flag covers both ledgers rather than one per module: an office reads
  // its registers one way or the other, and a per-module split would let them
  // drift apart for no reason anybody could explain later.
  //
  // This is the one place two offices see genuinely different table layouts, so
  // a change to either ledger has to be made in both branches. Requested by
  // MWPSD, who read their registers by column position.
  detailedLedgerColumns Boolean @default(false)

  // Whether incoming internal and external are two registers or one.
  //
  // MWPSD keeps them apart: two nav entries, two numbering runs each counting
  // from 001, two formats (see src/lib/documentTypeCodes.ts). That is how their
  // own tracker works and they asked for it. MWPTD does not — they file one
  // incoming ledger, and the split cost them a "New" button that silently
  // decided a document's numbering format from whichever nav item they happened
  // to press.
  //
  // Where this is false, DocumentOrigin goes back to being what the schema
  // comment on the enum describes: one field on one ledger, chosen on the form
  // and filterable, with a single numbering run behind it. Where it is true,
  // origin also selects the counter and the format.
  //
  // Defaults to false because one ledger is the simpler arrangement and the
  // original design; an office wanting two registers opts in.
  splitIncomingLedgers Boolean @default(false)

  // Whether this office's dashboard leads with the correspondence pipeline
  // board — the count of documents sitting at each handover between the desk,
  // the routed staff, the Division Chief's sign-off and the outgoing reply
  // (see src/lib/correspondencePipeline.ts).
  //
  // Separate from tracksArta on purpose, even though MWPTD is currently the
  // only office with both. ARTA is a legal duty about *lateness*; the pipeline
  // is an internal workflow question about *where a document is stalled*. An
  // office can meaningfully have one without the other, and folding them into
  // one flag would mean an ARTA-exempt division could never adopt the board
  // without also switching on due-date alerts it has no duty to act on.
  //
  // Defaults to false for the same reason tracksArta does: a division that
  // barely uses the Incoming ledger would get a board of four zeroes leading
  // its dashboard, which is worse than not having it.
  tracksCorrespondencePipeline Boolean @default(false)

  // Whether the incoming form is exactly this office's register — the twelve
  // columns of MWPTD's sheet, in their order, under their headings, and
  // nothing else. Every field it leaves out (time received, received by,
  // source, office/agency, signatory, notes) was empty on all eleven of their
  // live records: fields their register never had, so nobody ever filled them.
  //
  // Two consequences beyond which inputs render:
  //
  //  - There is no DC sign-off step. Their register goes routed → worked →
  //    date task completed, with no separate sign-off column, so
  //    dcSignOffDate is never collected and the pipeline board drops its
  //    "Awaiting closure" stage for this office (src/lib/correspondencePipeline.ts).
  //  - Every column is on the form from the start, blank until it applies,
  //    because the register is one row filled in over time rather than an
  //    intake screen and a follow-up screen.
  //
  // Defaults to false: the fuller form is the safe one for an office whose
  // register nobody has read yet, since it collects a superset.
  incomingRegisterForm Boolean @default(false)

  // Whether this office keeps an internal memorandum register — the module at
  // /internal, its nav entry, and its API routes.
  //
  // It is MWPTD's register: memoranda they issue to their own staff, numbered
  // in their own run. The other divisions do not keep one, and no office
  // outside MWPTD has ever created a memo, so switching it off strands nothing.
  //
  // Off by default. Unlike the display flags above, this one gates API routes
  // as well as UI: hiding a nav entry is convenience, and the boundary that
  // matters is the 404 in the route handler.
  tracksInternalMemos Boolean @default(false)

  // Whether this office keeps the DTR (Daily Time Record) filing register —
  // the module at /dtr, its nav entry and its API routes.
  //
  // Filing a DTR with HR is a universal obligation, but tracking the filing is
  // MWPTD's own practice and their sheet. Gated like the internal register, and
  // for the same reason: an office that keeps no such checklist should not be
  // able to reach the module by typing the URL.
  tracksDtr Boolean @default(false)

  // Whether this office keeps a D/IPCR — the performance commitment matrix at
  // /dipcr, its nav entry and its API routes. MWPTD's; gated like the DTR and
  // internal registers, and for the same reason.
  tracksDipcr Boolean @default(false)

  // Monotonic counters for auto-generated routing numbers — a live count()
  // would reuse numbers after a delete, colliding with the unique
  // constraint on routingNumber. Separate per module: Incoming and
  // Outgoing number independently in the source tracker.
  //
  // incomingSeqCounter numbers EXTERNAL incoming only. Internal incoming has
  // its own run, because the office treats the two as separate ledgers and
  // expects each to count from 001. The two can never collide despite both
  // starting at 1: external numbers are date-led (`081126-M-014`) and internal
  // ones type-led (`MOM-06-2026`), so the formats are structurally distinct —
  // see src/lib/documentTypeCodes.ts.
  incomingSeqCounter         Int @default(0)
  incomingInternalSeqCounter Int @default(0)
  outgoingSeqCounter         Int @default(0)

  // Whether this office runs SENA (Single Entry Approach) conciliation and
  // keeps the conference register for it. MWPTD's; nobody else holds the
  // conferences, so the module and its nav entry are omitted elsewhere rather
  // than shown leading to an empty ledger — same treatment as tracksDtr.
  tracksSena Boolean @default(false)

  // Whether this office keeps the telephone call log. Also MWPTD's. Kept as a
  // separate flag from tracksSena even though one office has both today: they
  // are different registers answering different questions, and an office could
  // plausibly keep a call log without running conciliation.
  tracksCallLog Boolean @default(false)

  // Whether this office keeps an IPCR Rating Guide — the sheet that fixes,
  // ahead of the period, what a 5 down to a 1 means for each success
  // indicator. Its own flag rather than riding on tracksDipcr, for the reason
  // tracksCallLog is separate from tracksSena: MWPTD happens to have both
  // today, but a division can perfectly well keep a D/IPCR without agreeing a
  // written rating scale for it, and one flag would make that unsayable.
  tracksIpcrRatingGuide Boolean @default(false)

  // Whether this office keeps the Legal Assistance register. MWPTD does: its
  // lawyers log every client assisted. A division with no legal officers has
  // the module omitted rather than shown leading to an empty ledger.
  tracksLegalAssistance Boolean @default(false)

  // Whether this office runs the regulation and licensing desk — deployment
  // certificates, LRA verifications and the rest. MWPTD does; a division that
  // does not has the module omitted rather than shown leading to an empty
  // ledger.
  tracksRegulationLicensing Boolean @default(false)

  users               User[]
  incoming            IncomingDocument[]
  outgoing            OutgoingDocument[]
  activities          Activity[]
  leaves              Leave[]
  internalMemos       InternalMemo[]
  dtrRecords          DtrRecord[]
  dipcrIndicators     DipcrIndicator[]
  senaConferences     SenaConference[]
  callLogs            CallLog[]
  ipcrRatingRows      IpcrRatingGuideRow[]
  legalAssistance     LegalAssistance[]
  regulationLicensing RegulationLicensing[]
  deliveriesReceived  DocumentDelivery[]    @relation("DeliveryRecipient")
}

model User {
  id           String   @id @default(cuid())
  officeId     String
  office       Office   @relation(fields: [officeId], references: [id])
  name         String
  username     String   @unique
  email        String? // contact detail and identifier; there is NO SMTP in this
  // system, so nothing is ever sent here. Nullable because
  // the seeded roster predates the field.
  passwordHash String
  role         Role     @default(STAFF)
  // Staff who leave are deactivated, never deleted: Leave, AuditLog,
  // IncomingRoutedStaff and ActivityAssignee all hold FKs to User, and their
  // history has to stay readable. Blocks sign-in; leaves every record intact.
  isActive     Boolean  @default(true)
  avatarUrl    String? // MinIO object key for the profile photo
  createdAt    DateTime @default(now())

  routedIncoming      IncomingRoutedStaff[]
  receivedIncoming    IncomingDocument[]           @relation("IncomingReceivedBy")
  activityAssignment  ActivityAssignee[]
  leaves              Leave[]
  dtrRecords          DtrRecord[]
  dipcrAccountable    DipcrAccountable[]
  ipcrAccountable     IpcrRatingGuideAccountable[]
  legalAssistance     LegalAssistance[]            @relation("LegalAssistanceOfficer")
  regulationLicensing RegulationLicensing[]        @relation("RegulationLicensingPersonnel")
  auditLogs           AuditLog[]
  formTemplates       FormTemplate[]
  senaMediations      SenaConference[]             @relation("SenaMediator")
  outgoingSubmitted   OutgoingVersion[]            @relation("OutgoingVersionSubmitter")
  outgoingReviewed    OutgoingVersion[]            @relation("OutgoingVersionReviewer")
  outgoingNotes       OutgoingNote[]               @relation("OutgoingNoteAuthor")
  deliveriesReceived  DocumentDelivery[]           @relation("DeliveryReceivedBy")
}

// One row of the D/IPCR (Division / Individual Performance Commitment and
// Review): a success indicator, what it costs, who is answerable for it, and
// what was actually done about it month by month.
//
// The sheet is a matrix — indicators down, months across — and that is the
// shape it is stored in: the indicator is the row, and each month's
// accomplishment is a DipcrAccomplishment hanging off it. Six text columns on
// this table would have mirrored the sheet more literally, but they would be
// named for one semester and could not answer "what did the division do in
// August" without reading every column of every row.
model DipcrIndicator {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  year     Int
  semester DipcrSemester

  // Column A's two levels, kept as text on the row rather than as their own
  // tables. The page groups by them to reproduce the sheet's merged cells.
  // A PAP is renamed rarely, and when it is, it is renamed on its own rows —
  // cheaper than a table nobody would otherwise open.
  section          String // "CORE FUNCTIONS"
  pap              String // "Forging of MOU/MOA Partnerships"
  // Column B — the target and its measure, as written.
  successIndicator String
  // Column C. Decimal, not Float: this is money, and it is stated to the
  // centavo on the sheet. Null where the sheet leaves it blank, which is most
  // rows — the budget is given once per PAP, against its first indicator.
  allottedBudget   Decimal? @db.Decimal(14, 2)
  // Column K.
  remarks          String?
  // Preserves the sheet's ordering within a PAP, which is meaningful — the
  // indicators read as a sequence, not a set.
  sortOrder        Int      @default(0)

  accountable     DipcrAccountable[]
  accomplishments DipcrAccomplishment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Every view of this module is one office's one semester.
  @@index([officeId, year, semester])
}

// Column D — who is answerable. A real link to the roster rather than the
// sheet's typed names, so the same person is the same person everywhere and
// "what is Cherryl accountable for" is a query. Same shape as
// IncomingRoutedStaff and ActivityAssignee.
model DipcrAccountable {
  indicatorId String
  indicator   DipcrIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id])

  @@id([indicatorId, userId])
}

// One cell of the Actual Accomplishments block: what was done for this
// indicator in this month.
model DipcrAccomplishment {
  id          String         @id @default(cuid())
  indicatorId String
  indicator   DipcrIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  // 1–12. Stored as the calendar month rather than an offset into the
  // semester, so a cell means the same thing whichever half of the year it
  // belongs to and nothing has to be re-based when the semester changes.
  month       Int
  narrative   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One cell per indicator per month — the matrix has no room for two.
  @@unique([indicatorId, month])
}

// One person's Daily Time Record for one month, and how far it has got on its
// way to HR. The office tracks this as a checklist, not a document: the value
// is knowing who has not filed yet, which is why the page renders the whole
// active roster for a month and marks the gaps rather than listing only the
// rows that exist.
//
// The sheet this comes from states the month and the date the batch was
// received once, in a merged cell over the rows. Both are stored per row
// instead: the module keeps the four-module shape that way, and a row remains
// meaningful on its own — filtered, printed, or read out of the audit log —
// without needing a parent row to explain it.
model DtrRecord {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // First day of the month the DTR covers, at UTC midnight — the period, not a
  // date anything happened on. Every query normalises to the 1st, so "July
  // 2026" is one value and not thirty-one near-misses.
  periodMonth         DateTime
  // When the office received the batch for that month ("DATE RECEIVED AUGUST 5,
  // 2026" in the sheet's group cell). Same for every row of a month in practice,
  // but stored per row — see above.
  dateReceived        DateTime?
  dateFiled           DateTime?
  dateSubmittedToHr   DateTime?
  personnelId         String
  personnel           User      @relation(fields: [personnelId], references: [id])
  // The sheet's "Submitted and checked" Yes/No.
  submittedAndChecked Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One DTR per person per month. This is what makes the roster view's "has
  // this person filed?" a lookup rather than a guess, and what stops the same
  // person being recorded twice for July because two people entered the batch.
  @@unique([officeId, periodMonth, personnelId])
  // The roster view always reads one office's rows for one month.
  @@index([officeId, periodMonth])
}

model IncomingDocument {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  dateReceived      DateTime
  // Clock time the document was accepted at the desk, "HH:MM" 24-hour.
  // Deliberately NOT folded into dateReceived: it is captured now, but the
  // ARTA calculation still runs off the date alone. Whether a 4:50 PM Friday
  // arrival counts as Friday or Monday is office policy, not an engineering
  // choice — see docs/PHP-TRACKER-ADOPTION.md. Do not wire it in by guessing.
  timeReceived      String?
  // The desk officer who accepted it, distinct from routedTo (who has to act
  // on it) and from the audit trail (who typed the record).
  receivedById      String?
  receivedBy        User?                 @relation("IncomingReceivedBy", fields: [receivedById], references: [id])
  origin            DocumentOrigin        @default(EXTERNAL)
  // Sending office or agency — "DMW - Ortigas", an employer, an email address.
  originAgency      String?
  // Person who signed the document, as printed on it.
  signatory         String?
  // Type code from src/lib/documentTypeCodes.ts (e.g. "M", "A", "MOM"). Was
  // previously only consumed to build routingNumber and then thrown away,
  // which left the ledger unable to answer "show me every advisory".
  documentType      String?
  // Free-text specification, used only when documentType == "O" (Others).
  // Required at the point of selection rather than optional — unlike
  // Activity.categoryOther, "Others" here is a deliberate pick from the legend
  // and never a default, so an unexplained one would say nothing at all.
  documentTypeOther String?
  routingNumber     String                @unique // e.g. 070126-L-008
  documentTitle     String
  routedTo          IncomingRoutedStaff[] // Division Chief may route to more than one staff member
  instructions      String? // DC's required actions — owned by Division Chief
  complexity        DocComplexity         @default(SIMPLE)
  leadTimeDays      Int                   @default(3) // derived from complexity, editable
  dueDate           DateTime? // dateReceived + leadTimeDays, computed on save
  progressRemarks   String? // what is happening with it (routing state)
  notes             String? // filing state, kept separate from progressRemarks
  dateCompleted     DateTime?
  dcSignOffDate     DateTime? // when the Division Chief signed off, distinct from ADAS III record-keeping
  scannedCopyUrl    String? // MinIO object key
  filed             Boolean               @default(false)

  // The replies dispatched in response. How many drafts a reply took is not
  // stored here — it is the number of OutgoingVersion rows hanging off the
  // reply, shown in the ledger as "No. of versions". A stored count beside a
  // version history is a copy that can only ever drift out of step with it.
  outgoingReplies  OutgoingDocument[]
  delivery         DocumentDelivery?
  linkedActivities IncomingDocumentActivity[] // the activities this document concerns
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
}

// join table: a document can concern several activities and an activity can
// have several documents — e.g. an advisory, an office order and a terminal
// report all attached to one job fair. Same shape as IncomingRoutedStaff and
// ActivityAssignee; this is the incoming-side counterpart to
// OutgoingDocument.relatedIncomingId.
model IncomingDocumentActivity {
  incomingId String
  incoming   IncomingDocument @relation(fields: [incomingId], references: [id])
  activityId String
  activity   Activity         @relation(fields: [activityId], references: [id])

  @@id([incomingId, activityId])
}

// The outgoing-side counterpart, same shape. The office's own outgoing register
// offers "Link to Tentative Activity(s) (optional, can select more than one)",
// so a dispatch — a terminal report, an invitation letter — can name the job
// fair or seminar it belongs to.
model OutgoingDocumentActivity {
  outgoingId String
  outgoing   OutgoingDocument @relation(fields: [outgoingId], references: [id])
  activityId String
  activity   Activity         @relation(fields: [activityId], references: [id])

  @@id([outgoingId, activityId])
}

model OutgoingDocument {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // Null until the document physically leaves. A reply spends its whole draft
  // and review life on the work board, where there is no release date to state
  // — writing one early would put a date in the register for something that
  // had not happened.
  dateReleased      DateTime?
  // Two ways a dispatch gets its number, and the difference is visible in the
  // string:
  //
  //  - A REPLY inherits the routing number of the incoming document it answers,
  //    unchanged (081126-M-014). That is the "one-time routing number": one
  //    number per transaction, carried from the receiving desk to the release,
  //    so staff searching it find both halves and never have to hold two
  //    numbers for one piece of work. It costs nothing — routingNumber is
  //    unique per table, so the same string in both tables is legal — and it
  //    burns no sequence number, because the incoming side already spent one.
  //    A second reply to the same incoming is suffixed -R2, -R3 (see
  //    buildReplyRoutingNumber in src/lib/documentTypeCodes.ts).
  //  - An ORIGINATED dispatch — a transmittal or report the division starts
  //    itself, answering nothing — has nothing to inherit, so it draws from
  //    outgoingSeqCounter as before (081126-MWPTD-L-004).
  //
  // Null while an originated dispatch is still a draft: the counter is claimed
  // at release, so a draft that is still being revised does not hold a number
  // out of the register and leave a gap in the date order the format is built
  // from. Postgres allows many NULLs under a unique index, so the constraint
  // still means what it meant.
  routingNumber     String?   @unique // e.g. 070226-MWPTD-DC-004
  // Type code from src/lib/documentTypeCodes.ts, stored so the ledger can be
  // filtered by type — the incoming side already does this.
  documentType      String?
  // See IncomingDocument.documentTypeOther — same rule.
  documentTypeOther String?
  documentTitle     String
  instructions      String?

  // Receipt acknowledgement: who took delivery, where, and when. The office's
  // own outgoing register records all four, and they are how it answers "did
  // this actually reach them?" — a released document with no receipt is the
  // thing a clerk chases. All nullable: a document is logged when it leaves,
  // and the receipt comes back later, if at all.
  receivingOffice String? // recipient division/office — "PROTECTION", "FAD", "ORD"
  receivedBy      String? // person who took delivery, free text
  receivedDate    DateTime? // date the recipient acknowledged it
  receivedTime    String? // "10:54 PM" — clock time, same shape as IncomingDocument.timeReceived

  // The summary line the printed register carries. The running account of what
  // is happening lives in versions and notes below; this stays as the one-line
  // column the sheet has always had.
  progressRemarks String?
  scannedCopyUrl  String?
  filed           Boolean @default(false)

  // DRAFT for anything created on the work board; RELEASED is backfilled onto
  // every row that predates the review loop, since each of those was already a
  // released dispatch by definition — the register had no other kind of row.
  status   OutgoingStatus    @default(DRAFT)
  versions OutgoingVersion[]
  notes    OutgoingNote[]

  relatedIncomingId String?
  relatedIncoming   IncomingDocument? @relation(fields: [relatedIncomingId], references: [id])

  linkedActivities OutgoingDocumentActivity[] // the activities this dispatch concerns

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  // The divisions this dispatch was addressed to that keep records here.
  deliveries DocumentDelivery[]
}

// One round trip of the reply between the staff member writing it and the
// Division Chief checking it: the draft that was sent up, and what came back.
//
// Both halves are on one row on purpose. A submission and its verdict are the
// same event seen from two desks, and splitting them would make "how many times
// did this come back?" a join instead of a count. reviewedAt is null exactly
// while the version is still sitting with the Chief, which is what makes
// "what is waiting on me" a query rather than a scan of the status column.
//
// Append-only, like AuditLog: a superseded version is history, not a draft to
// be tidied away. That is the whole point of versioning it — the office wants
// to see that a reply went back twice, not just that it eventually went out.
model OutgoingVersion {
  id         String           @id @default(cuid())
  outgoingId String
  outgoing   OutgoingDocument @relation(fields: [outgoingId], references: [id], onDelete: Cascade)

  // 1, 2, 3… within one reply. Allocated in the same transaction as the row so
  // two submissions cannot claim the same number; see the unique index below,
  // which is what actually enforces it.
  versionNumber Int
  // The draft itself — a MinIO object key from POST /api/upload, never a value
  // built anywhere else (see src/lib/minio.ts). Required: a submission with
  // nothing attached is a progress note, and that is what OutgoingNote is for.
  fileUrl       String
  fileName      String
  // What changed this round, in the submitter's words.
  staffNote     String?
  submittedById String
  submittedBy   User     @relation("OutgoingVersionSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  // Null until the Chief answers. canSignOffAsChief gates writing these three,
  // the same check that gates the incoming side's sign-off.
  outcome      OutgoingReviewOutcome?
  chiefRemarks String?
  reviewedById String?
  reviewedBy   User?                  @relation("OutgoingVersionReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Two rows cannot be version 3 of the same reply.
  @@unique([outgoingId, versionNumber])
  // The timeline reads one reply's rounds in order.
  @@index([outgoingId, versionNumber])
}

// A progress note with no draft attached — "waiting on the employer's reply",
// "endorsed to Legal". Deliberately not an OutgoingVersion: nothing was
// submitted and nothing is waiting on the Chief, so numbering it would inflate
// the round count that the version history exists to report honestly.
//
// Kept because the pipeline board's job is finding stalled documents, and a
// staff member held up by an outside party has to be able to say so without
// inventing a draft to attach.
model OutgoingNote {
  id         String           @id @default(cuid())
  outgoingId String
  outgoing   OutgoingDocument @relation(fields: [outgoingId], references: [id], onDelete: Cascade)

  body      String
  authorId  String
  author    User     @relation("OutgoingNoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([outgoingId, createdAt])
}

model Activity {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  date                DateTime // start date; single-day activities just use this
  endDate             DateTime? // set only for multi-day activities; must be >= date
  activityName        String
  // Defaults to OTHERS so every pre-existing row stays valid without a
  // backfill guess: "unclassified" is honest, a fabricated category is not.
  category            ActivityCategory @default(OTHERS)
  // Free-text specification, used only when category == OTHERS — same shape as
  // Leave.typeOther. Optional rather than required (unlike leave's, where OTHER
  // is a deliberate pick among five named types): OTHERS is this column's
  // default and means "unclassified", so demanding text would tax every
  // activity nobody bothered to categorise.
  categoryOther       String?
  location            String? // where it happens — "Butuan City Hall"
  remarks             String?
  officeOrderUrl      String?
  memoUrl             String?
  inspectionReportUrl String?

  assignees      ActivityAssignee[]
  linkedIncoming IncomingDocumentActivity[]
  linkedOutgoing OutgoingDocumentActivity[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
}

// join table: an activity can have multiple people in charge
model ActivityAssignee {
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@id([activityId, userId])
}

// join table: an incoming document can be routed to multiple staff (the
// Division Chief may need to assign more than one person to the same document)
model IncomingRoutedStaff {
  incomingId String
  incoming   IncomingDocument @relation(fields: [incomingId], references: [id])
  userId     String
  user       User             @relation(fields: [userId], references: [id])

  @@id([incomingId, userId])
}

model Leave {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  dateFiled      DateTime?
  leaveStart     DateTime
  leaveEnd       DateTime?
  type           LeaveType @default(OTHER)
  typeOther      String? // free-text specification, used when type == OTHER
  personnelId    String
  personnel      User      @relation(fields: [personnelId], references: [id])
  scannedCopyUrl String?

  createdAt DateTime @default(now())
}

model InternalMemo {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  dateReleased     DateTime
  memorandumNumber Int // manually entered; unique within the office, not globally (see routingNumber)
  documentTitle    String
  instructions     String?
  receivedBy       String?
  progressRemarks  String?
  scannedCopyUrl   String?
  filed            Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([officeId, memorandumNumber])
}

// Shared template library — deliberately NOT officeId-scoped, unlike every
// other table here: these are standard DMW forms reused by every office,
// not office-specific records. uploadedBy still gives an audit trail.
model FormTemplate {
  id           String @id @default(cuid())
  number       Int // display order, matches the source sheet's "Number" column
  title        String
  fileUrl      String // MinIO object key, "shared/forms/..." prefix
  fileName     String // original filename, for display/download naming
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Optional but recommended for a government accountability system:
// every create/update/delete on the tables above should write a row here.
model AuditLog {
  id         String   @id @default(cuid())
  officeId   String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String // "CREATE" | "UPDATE" | "DELETE" | "READ"
  entityType String // "IncomingDocument" | "OutgoingDocument" | ... | "File"
  entityId   String
  ipAddress  String?
  details    Json?
  createdAt  DateTime @default(now())
}

// How a SENA conference ended. The sheet records SETTLED, FOR 2ND CON and
// WITHDRAWN, and leaves the cell blank for a conference that is on the calendar
// but hasn't happened yet — that blank is SCHEDULED here, so "what is booked
// this week" is a query rather than a search for empty cells.
//
// NOT_SETTLED is not in the sheet but is a real SENA outcome: the parties meet
// and reach no agreement, and the case moves on. Without it those conferences
// have nowhere to go but WITHDRAWN, which means something different (the
// complainant pulled out) and would misreport the office's settlement rate.
enum SenaStatus {
  SCHEDULED
  SETTLED
  FOR_SECOND_CONFERENCE
  NOT_SETTLED
  WITHDRAWN
}

// One row per conference, exactly as the office's sheet keeps it — not one row
// per case. A case that needs a second conference is a second row, the way they
// already enter it.
//
// previousConferenceId is what the sheet cannot express. There, a 2nd
// conference is recognisable as a follow-up only because a reader notices the
// same complainant and respondent further down the page; nothing links them, so
// nothing can total a case or list what is still open. This is the same move
// OutgoingDocument.relatedIncomingId makes over the original tracker's manual
// note: the register keeps its shape, and the link it implied becomes real.
//
// Deliberately NOT unique: a chain (1st -> 2nd -> 3rd) is the normal case, and
// constraining it would also forbid correcting a mis-linked row by pointing a
// second one at the same parent while the first is being fixed.
model SenaConference {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // The sheet's month header plus a day number; stored as a real date so a
  // month view is a range query and December to January doesn't need special
  // handling.
  conferenceDate   DateTime
  // The sheet's TIME dropdown, stored 24-hour ("13:30") rather than as the
  // "1:30 PM" it displays. Two reasons: it sorts lexically, so a day's
  // conferences come back in the order they happen without a lookup table; and
  // the display format stays a rendering choice. See src/lib/senaSchedule.ts.
  conferenceTime   String
  // 1st, 2nd, 3rd. An Int rather than an enum so a third or fourth conference
  // needs no migration — the sheet only ever shows 1st and 2nd, but nothing
  // about SENA caps it there.
  conferenceNumber Int      @default(1)

  // The dropdown in the sheet lists staff by name; here it is the staff record
  // itself, so a conciliator's conferences are a real relation. Same treatment
  // as DtrRecord.personnel.
  mediatorId String
  mediator   User   @relation("SenaMediator", fields: [mediatorId], references: [id])

  // Free text on both sides. The complainant is a worker and the respondent is
  // usually a recruitment agency, but neither is a record this app holds — the
  // agencies are not offices and the workers are not users.
  complainant String
  respondent  String

  status SenaStatus @default(SCHEDULED)

  // Peso amount, only meaningful when status is SETTLED. Decimal, not Float:
  // this is money, and 16000.00 must not come back as 15999.999999999998.
  amountSettled Decimal? @db.Decimal(12, 2)

  previousConferenceId String?
  previousConference   SenaConference?  @relation("SenaFollowUp", fields: [previousConferenceId], references: [id])
  followUps            SenaConference[] @relation("SenaFollowUp")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The register is read one office at a time, newest first.
  @@index([officeId, conferenceDate])
  @@index([previousConferenceId])
}

// The telephone log. The plainest register in the app: five columns, no
// dropdowns in the source sheet, and no links to anything else.
//
// concern and remarks are free text on purpose. Their values repeat a lot
// ("SENA UPDATE", "FORWARDED TO CCO") and a picklist would tidy the reporting,
// but the sheet has none, the vocabulary is still moving, and a wrong picklist
// makes a clerk pick "Others" and type the real answer anyway. Worth revisiting
// once a few months of entries show which values have actually settled.
model CallLog {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  callDate DateTime

  // String, never a number. The sheet's numbers are mobile numbers with a
  // leading zero ("09653144676"), and anything numeric eats it — which is
  // exactly why some rows in the sheet have already lost theirs ("9175218138").
  phoneNumber String
  // "UNKNOWN" is a normal, frequent value here rather than missing data: the
  // call was logged, the caller simply didn't give a name.
  callerName  String
  concern     String
  remarks     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId, callDate])
}

// The three things every success indicator is scored on. Not every indicator
// uses all three — the sheet gives some rows Quality and Efficiency only, and a
// missing dimension means "not rated on this", not "rated zero". That is why
// descriptors are rows rather than columns: an unused dimension simply has no
// row, and nothing has to encode the difference between blank and absent.
enum IpcrRatingDimension {
  QUALITY
  EFFICIENCY
  TIMELINESS
}

// One line of the IPCR Rating Guide: an indicator, and what each score from 5
// down to 1 will be taken to mean for it. Agreed at the start of the period,
// which is the whole point of the sheet — the scale is settled before there is
// anything to score, so a rating later is a reading rather than an argument.
//
// Deliberately its own table rather than columns hung off DipcrIndicator, even
// though columns A–C say the same things. The two sheets are kept and revised
// as separate documents here, and sharing rows would have meant one could not
// be edited without touching the other.
model IpcrRatingGuideRow {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // Scoped like the D/IPCR: a rating guide belongs to one office's one
  // semester, and reuses that module's semester enum rather than declaring a
  // second identical one.
  year     Int
  semester DipcrSemester

  // Column A's two levels, kept as text on the row for the same reason the
  // D/IPCR does it: the page groups by them to rebuild the sheet's merged
  // cells, and a PAP is renamed rarely enough not to earn a table.
  section             String // "CORE FUNCTIONS"
  pap                 String // "MOU/MOA partnerships forged with LGUs..."
  // Column B — the target and its measure, as written on the sheet.
  successIndicator    String
  // Column D. Nullable because the sheet leaves it blank on some rows.
  meansOfVerification String?
  // Preserves the sheet's order within a PAP, which is meaningful — the
  // indicators read as a sequence, not a set.
  sortOrder           Int     @default(0)

  accountable IpcrRatingGuideAccountable[]
  ratings     IpcrRatingDescriptor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Every view of this module is one office's one semester.
  @@index([officeId, year, semester])
}

// Column C — who is answerable. A real link to the roster rather than the
// sheet's typed names ("Apple, Cherryl"), so the same person is the same person
// everywhere. Same shape as DipcrAccountable and IncomingRoutedStaff.
model IpcrRatingGuideAccountable {
  rowId  String
  row    IpcrRatingGuideRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  userId String
  user   User               @relation(fields: [userId], references: [id])

  @@id([rowId, userId])
}

// One dimension's five descriptors for one indicator — the right-hand block of
// the sheet, where a row reads across from Outstanding to Poor.
model IpcrRatingDescriptor {
  id        String              @id @default(cuid())
  rowId     String
  row       IpcrRatingGuideRow  @relation(fields: [rowId], references: [id], onDelete: Cascade)
  dimension IpcrRatingDimension

  // Numbered for the score they describe, not named, because that is how the
  // sheet's headings read and how anybody rating against it will speak: "that
  // is a 4". All nullable — the sheet leaves cells blank where a level needs no
  // separate wording (see "Not developed" spanning 2 and 1 on some rows).
  level5 String? // Outstanding
  level4 String? // Very Satisfactory
  level3 String? // Satisfactory
  level2 String? // Unsatisfactory
  level1 String? // Poor

  // A dimension appears at most once per indicator; the sheet has no room for
  // two Quality rows on one indicator and neither does this.
  @@unique([rowId, dimension])
}

// Column D. Two tick-boxes on the sheet, one field here: every row has exactly
// one of them marked, and two booleans would allow "both" and "neither", which
// the register has no way to mean.
enum ClientSex {
  MALE
  FEMALE
}

// Columns E–L — what was actually given. Kept as the sheet's own abbreviations
// rather than expanded guesses: these are the office's terms, they are what the
// column headings say, and inventing long forms for them would put words in the
// register nobody there uses.
//
// A list, not a single choice: rows routinely carry several ticks (RV with
// money claims and DAE, for instance), so one column cannot hold the answer.
enum LegalAssistanceForm {
  RV
  MONEY_CLAIMS
  DAW
  DAE
  IR
  TIP
  NON_SUPPORT
  OTHERS
}

// One client seen, on one date, by one legal officer — the office's Legal
// Assistance register, a row per person assisted rather than per case.
model LegalAssistance {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // The sheet's month header plus a day number, stored as a real date for the
  // same reason SenaConference does it: a month view is then a range query, and
  // December to January needs no special handling.
  assistanceDate DateTime

  // Column B is a dropdown of the office's lawyers, so it is the staff record
  // itself rather than the typed name — "what did Atty. Liem handle in August"
  // becomes a query. Same treatment as SenaConference.mediator.
  legalOfficerId String
  legalOfficer   User   @relation("LegalAssistanceOfficer", fields: [legalOfficerId], references: [id])

  // Column C. Free text: the client is a walk-in member of the public, not a
  // record this app holds.
  clientName String
  sex        ClientSex

  // Columns E–L, as a set. Empty is legal — a row can be logged before anyone
  // has decided what form the assistance took.
  forms LegalAssistanceForm[]

  // What "Others" was, in the officer's own words. Only meaningful when
  // OTHERS is among the forms above, and the API clears it when that tick is
  // removed — a detail left behind by an untick would describe assistance the
  // row no longer says was given.
  //
  // Optional even when OTHERS is ticked: the sheet's column is a bare
  // tick-box, so a row that only ticks it is still a row the register can
  // hold, and refusing to save it would be this app inventing a rule the
  // office does not have.
  othersDetail String?

  // Column M — the scanned completed LAD. A MinIO object key from
  // POST /api/upload, never a value built anywhere else (see src/lib/minio.ts).
  scannedCopyUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The register is read one office at a time, newest first.
  @@index([officeId, assistanceDate])
}

// Columns E–J — the services the desk actually rendered. A list, not a single
// choice: one caller is commonly given more than one, and the sheet ticks each
// separately.
//
// Named for what the column headings say. "ACCREDATION" on the sheet is a
// misspelling of accreditation and is spelled correctly here — unlike RV or DAE
// on the legal assistance register, this is a word with one spelling rather
// than an office abbreviation to be preserved.
enum RegulationLicensingService {
  DEPLOYMENT_CERTIFICATE
  LRA_DIRECTORY
  LRA_VERIFICATION
  LRA_PERSONNEL_ACCREDITATION
  SRA_ASSISTANCE
  SUBMISSION_OF_REPORTS
  OTHERS
}

// One requesting party served, on one date, by one member of staff — the
// office's Regulation and Licensing register.
model RegulationLicensing {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // Stored as a real date for the same reason the other registers do it: a
  // month view is then a range query, and December to January needs no special
  // handling.
  serviceDate DateTime

  // Column B is the staff member who attended to it, so it is the roster record
  // rather than the typed name — the same treatment as LegalAssistance's legal
  // officer.
  personnelId String
  personnel   User   @relation("RegulationLicensingPersonnel", fields: [personnelId], references: [id])

  // Column C. Free text: the requesting party is a member of the public or an
  // agency, neither of which is a record this app holds.
  requestingParty String
  // Column D. Reuses the legal assistance register's enum rather than declaring
  // a second identical one — it is the same fact about a person either way.
  sex             ClientSex

  // Columns E–J, as a set. Empty is legal: a row can be logged before anyone
  // has settled what was given.
  services RegulationLicensingService[]

  // What "Others" was, in the officer's own words. Only meaningful while
  // OTHERS is among the services above, and the API clears it when that tick
  // is removed — a detail left behind by an untick would describe a service
  // the row no longer says was rendered. Same rule as the legal assistance
  // register's othersDetail.
  othersDetail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The register is read one office at a time, newest first.
  @@index([officeId, serviceDate])
}

enum DeliveryStatus {
  PENDING // released and addressed here, not yet taken in
  RECEIVED // the receiving office has filed it in their own register
}

// One released dispatch, addressed to one division that keeps its records in
// this app. The link between two offices' ledgers, and the only thing in the
// schema that crosses the officeId boundary on purpose.
//
// Why a row rather than creating the recipient's IncomingDocument outright:
// dateReceived, timeReceived and receivedBy are facts about the recipient's own
// desk, and a document appearing in their register already stamped "received"
// would be this app inventing a receipt nobody made. So the release raises a
// PENDING delivery; the recipient files it, and only then does an incoming
// record exist — with their number, their date and their name on it.
//
// It also closes the loop the other way. OutgoingDocument.receivedBy /
// receivedDate / receivedTime exist so the sender can answer "did this actually
// reach them?", and until now the only way to fill them was to ring up and ask.
// The recipient filing a delivery answers it directly.
//
// Only the tick codes that name a tenant division produce one of these: ARD and
// ADJU take documents but keep no records here, so a dispatch to them stays
// what it has always been — a line in the sender's own register.
model DocumentDelivery {
  id String @id @default(cuid())

  // Cascade: a dispatch deleted from the sender's register takes its
  // undelivered addressing with it. Anything already RECEIVED has produced an
  // IncomingDocument that belongs to the recipient, and that survives — see
  // receivedIncomingId, which is deliberately not a cascade.
  outgoingId String
  outgoing   OutgoingDocument @relation(fields: [outgoingId], references: [id], onDelete: Cascade)

  // The division it is addressed to. The division it came FROM needs no column:
  // it is outgoing.officeId, and duplicating it here would be a second copy of
  // the same fact that could disagree with the first.
  toOfficeId String
  toOffice   Office @relation("DeliveryRecipient", fields: [toOfficeId], references: [id])

  status DeliveryStatus @default(PENDING)

  // What the recipient made of it. Unique because one delivery becomes at most
  // one register entry — filing it twice would put the same dispatch in their
  // ledger under two numbers.
  receivedIncomingId String?           @unique
  receivedIncoming   IncomingDocument? @relation(fields: [receivedIncomingId], references: [id])
  receivedById       String?
  receivedBy         User?             @relation("DeliveryReceivedBy", fields: [receivedById], references: [id])
  receivedAt         DateTime?

  createdAt DateTime @default(now())

  // A dispatch is addressed to an office once. Re-releasing must not raise a
  // second delivery for a division that already has it.
  @@unique([outgoingId, toOfficeId])
  // The recipient's tray: their pending deliveries, newest first.
  @@index([toOfficeId, status])
}
