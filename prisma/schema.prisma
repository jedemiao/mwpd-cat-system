// MWPD Communication & Activity Tracker — database schema
// Every core table carries officeId so the same schema supports
// one division today and many offices sharing one instance later.
// Pair officeId with Postgres Row-Level Security policies in production
// (see README) so office A can never query office B's rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN            // full system access, manages offices/users
  DIVISION_CHIEF   // approves, signs off, sees all division data
  RECORDS_STAFF    // ADAS III / intake & filing (Incoming/Outgoing entry)
  STAFF            // field staff, logs activities, requests leave
}

enum DocComplexity {
  SIMPLE           // ARTA: 3 working days
  COMPLEX          // ARTA: 7 working days
  HIGHLY_TECHNICAL // ARTA: 20 working days
}

// Where a document came from. The source tracker splits these into two
// separate pages and two near-identical ledgers; here it is one field on one
// ledger, so the distinction is filterable without duplicating the module.
enum DocumentOrigin {
  INTERNAL // from within DMW — other divisions, regional/central office
  EXTERNAL // from outside — agencies, employers, walk-in clients, email
}

// The office's own vocabulary for what a day on the calendar is, taken from
// the source tracker's "Legend" dropdown. One category per activity.
//
// Their legend has a tenth entry, "On Leave", which is deliberately NOT a
// value here. They have no Leave module, so leave is filed as an activity with
// Legend = On Leave and the person's name typed in free text. We have a real
// Leave model, so leave is *projected* onto the calendar from that table at
// render time. Leaving ON_LEAVE out of the enum means the API cannot accept it
// either — the Leave module stays the only place a leave can be created, and
// there is exactly one source of truth for who is out.
enum ActivityCategory {
  JOB_FAIR
  PEOS // Pre-Employment Orientation Seminar
  QUICK_RESPONSE_TEAM
  CONFERENCE_TRAINING
  MEETINGS
  SKELETON_FORCE
  PUBLIC_HOLIDAY
  OTHERS
}

// Which half of the year a D/IPCR covers. The office prepares one sheet per
// semester ("D/IPCR 2ND SEM"), and the six month columns on it are the months
// of that half — so the semester decides which months the matrix shows.
enum DipcrSemester {
  FIRST  // January–June
  SECOND // July–December
}

enum LeaveType {
  CTO
  VACATION
  SICK
  EMERGENCY
  OTHER
}

model Office {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // short code, e.g. "MWPTD-CARAGA"
  createdAt DateTime @default(now())

  // Whether this office is subject to ARTA (Anti-Red Tape Act) due dates.
  // Only MWPTD is — the other divisions and ORD are exempt, so due-date
  // alerts, the nav badge and the dashboard's compliance board are all
  // meaningless noise for them.
  //
  // Defaults to false so a division onboarded later is exempt unless someone
  // deliberately opts it in: wrongly showing an office overdue-document alerts
  // it has no duty to act on is worse than wrongly showing none, and the
  // second mistake is the one anybody would notice.
  tracksArta Boolean @default(false)

  // Whether the incoming and outgoing ledgers render this office's full
  // register layout, copied column-for-column from MWPSD's own tracker.
  // Everyone else keeps the compact ledgers, which fit a printed sheet where
  // the register layouts do not.
  //
  // One flag covers both ledgers rather than one per module: an office reads
  // its registers one way or the other, and a per-module split would let them
  // drift apart for no reason anybody could explain later.
  //
  // This is the one place two offices see genuinely different table layouts, so
  // a change to either ledger has to be made in both branches. Requested by
  // MWPSD, who read their registers by column position.
  detailedLedgerColumns Boolean @default(false)

  // Whether incoming internal and external are two registers or one.
  //
  // MWPSD keeps them apart: two nav entries, two numbering runs each counting
  // from 001, two formats (see src/lib/documentTypeCodes.ts). That is how their
  // own tracker works and they asked for it. MWPTD does not — they file one
  // incoming ledger, and the split cost them a "New" button that silently
  // decided a document's numbering format from whichever nav item they happened
  // to press.
  //
  // Where this is false, DocumentOrigin goes back to being what the schema
  // comment on the enum describes: one field on one ledger, chosen on the form
  // and filterable, with a single numbering run behind it. Where it is true,
  // origin also selects the counter and the format.
  //
  // Defaults to false because one ledger is the simpler arrangement and the
  // original design; an office wanting two registers opts in.
  splitIncomingLedgers Boolean @default(false)

  // Whether this office's dashboard leads with the correspondence pipeline
  // board — the count of documents sitting at each handover between the desk,
  // the routed staff, the Division Chief's sign-off and the outgoing reply
  // (see src/lib/correspondencePipeline.ts).
  //
  // Separate from tracksArta on purpose, even though MWPTD is currently the
  // only office with both. ARTA is a legal duty about *lateness*; the pipeline
  // is an internal workflow question about *where a document is stalled*. An
  // office can meaningfully have one without the other, and folding them into
  // one flag would mean an ARTA-exempt division could never adopt the board
  // without also switching on due-date alerts it has no duty to act on.
  //
  // Defaults to false for the same reason tracksArta does: a division that
  // barely uses the Incoming ledger would get a board of four zeroes leading
  // its dashboard, which is worse than not having it.
  tracksCorrespondencePipeline Boolean @default(false)

  // Whether the incoming form is exactly this office's register — the twelve
  // columns of MWPTD's sheet, in their order, under their headings, and
  // nothing else. Every field it leaves out (time received, received by,
  // source, office/agency, signatory, notes) was empty on all eleven of their
  // live records: fields their register never had, so nobody ever filled them.
  //
  // Two consequences beyond which inputs render:
  //
  //  - There is no DC sign-off step. Their register goes routed → worked →
  //    date task completed, with no separate sign-off column, so
  //    dcSignOffDate is never collected and the pipeline board drops its
  //    "Awaiting closure" stage for this office (src/lib/correspondencePipeline.ts).
  //  - Every column is on the form from the start, blank until it applies,
  //    because the register is one row filled in over time rather than an
  //    intake screen and a follow-up screen.
  //
  // Defaults to false: the fuller form is the safe one for an office whose
  // register nobody has read yet, since it collects a superset.
  incomingRegisterForm Boolean @default(false)

  // Whether this office keeps an internal memorandum register — the module at
  // /internal, its nav entry, and its API routes.
  //
  // It is MWPTD's register: memoranda they issue to their own staff, numbered
  // in their own run. The other divisions do not keep one, and no office
  // outside MWPTD has ever created a memo, so switching it off strands nothing.
  //
  // Off by default. Unlike the display flags above, this one gates API routes
  // as well as UI: hiding a nav entry is convenience, and the boundary that
  // matters is the 404 in the route handler.
  tracksInternalMemos Boolean @default(false)

  // Whether this office keeps the DTR (Daily Time Record) filing register —
  // the module at /dtr, its nav entry and its API routes.
  //
  // Filing a DTR with HR is a universal obligation, but tracking the filing is
  // MWPTD's own practice and their sheet. Gated like the internal register, and
  // for the same reason: an office that keeps no such checklist should not be
  // able to reach the module by typing the URL.
  tracksDtr Boolean @default(false)

  // Whether this office keeps a D/IPCR — the performance commitment matrix at
  // /dipcr, its nav entry and its API routes. MWPTD's; gated like the DTR and
  // internal registers, and for the same reason.
  tracksDipcr Boolean @default(false)

  // Monotonic counters for auto-generated routing numbers — a live count()
  // would reuse numbers after a delete, colliding with the unique
  // constraint on routingNumber. Separate per module: Incoming and
  // Outgoing number independently in the source tracker.
  //
  // incomingSeqCounter numbers EXTERNAL incoming only. Internal incoming has
  // its own run, because the office treats the two as separate ledgers and
  // expects each to count from 001. The two can never collide despite both
  // starting at 1: external numbers are date-led (`081126-M-014`) and internal
  // ones type-led (`MOM-06-2026`), so the formats are structurally distinct —
  // see src/lib/documentTypeCodes.ts.
  incomingSeqCounter         Int @default(0)
  incomingInternalSeqCounter Int @default(0)
  outgoingSeqCounter         Int @default(0)

  users         User[]
  incoming      IncomingDocument[]
  outgoing      OutgoingDocument[]
  activities    Activity[]
  leaves        Leave[]
  internalMemos InternalMemo[]
  dtrRecords    DtrRecord[]
  dipcrIndicators DipcrIndicator[]
}

model User {
  id           String   @id @default(cuid())
  officeId     String
  office       Office   @relation(fields: [officeId], references: [id])
  name         String
  username     String   @unique
  email        String?  // contact detail and identifier; there is NO SMTP in this
                        // system, so nothing is ever sent here. Nullable because
                        // the seeded roster predates the field.
  passwordHash String
  role         Role     @default(STAFF)
  // Staff who leave are deactivated, never deleted: Leave, AuditLog,
  // IncomingRoutedStaff and ActivityAssignee all hold FKs to User, and their
  // history has to stay readable. Blocks sign-in; leaves every record intact.
  isActive     Boolean  @default(true)
  avatarUrl    String?  // MinIO object key for the profile photo
  createdAt    DateTime @default(now())

  routedIncoming     IncomingRoutedStaff[]
  receivedIncoming   IncomingDocument[]    @relation("IncomingReceivedBy")
  activityAssignment ActivityAssignee[]
  leaves             Leave[]
  dtrRecords         DtrRecord[]
  dipcrAccountable   DipcrAccountable[]
  auditLogs          AuditLog[]
  formTemplates      FormTemplate[]
}

// One row of the D/IPCR (Division / Individual Performance Commitment and
// Review): a success indicator, what it costs, who is answerable for it, and
// what was actually done about it month by month.
//
// The sheet is a matrix — indicators down, months across — and that is the
// shape it is stored in: the indicator is the row, and each month's
// accomplishment is a DipcrAccomplishment hanging off it. Six text columns on
// this table would have mirrored the sheet more literally, but they would be
// named for one semester and could not answer "what did the division do in
// August" without reading every column of every row.
model DipcrIndicator {
  id       String        @id @default(cuid())
  officeId String
  office   Office        @relation(fields: [officeId], references: [id])

  year     Int
  semester DipcrSemester

  // Column A's two levels, kept as text on the row rather than as their own
  // tables. The page groups by them to reproduce the sheet's merged cells.
  // A PAP is renamed rarely, and when it is, it is renamed on its own rows —
  // cheaper than a table nobody would otherwise open.
  section          String  // "CORE FUNCTIONS"
  pap              String  // "Forging of MOU/MOA Partnerships"
  // Column B — the target and its measure, as written.
  successIndicator String
  // Column C. Decimal, not Float: this is money, and it is stated to the
  // centavo on the sheet. Null where the sheet leaves it blank, which is most
  // rows — the budget is given once per PAP, against its first indicator.
  allottedBudget   Decimal? @db.Decimal(14, 2)
  // Column K.
  remarks          String?
  // Preserves the sheet's ordering within a PAP, which is meaningful — the
  // indicators read as a sequence, not a set.
  sortOrder        Int      @default(0)

  accountable     DipcrAccountable[]
  accomplishments DipcrAccomplishment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Every view of this module is one office's one semester.
  @@index([officeId, year, semester])
}

// Column D — who is answerable. A real link to the roster rather than the
// sheet's typed names, so the same person is the same person everywhere and
// "what is Cherryl accountable for" is a query. Same shape as
// IncomingRoutedStaff and ActivityAssignee.
model DipcrAccountable {
  indicatorId String
  indicator   DipcrIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id])

  @@id([indicatorId, userId])
}

// One cell of the Actual Accomplishments block: what was done for this
// indicator in this month.
model DipcrAccomplishment {
  id          String         @id @default(cuid())
  indicatorId String
  indicator   DipcrIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  // 1–12. Stored as the calendar month rather than an offset into the
  // semester, so a cell means the same thing whichever half of the year it
  // belongs to and nothing has to be re-based when the semester changes.
  month     Int
  narrative String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One cell per indicator per month — the matrix has no room for two.
  @@unique([indicatorId, month])
}

// One person's Daily Time Record for one month, and how far it has got on its
// way to HR. The office tracks this as a checklist, not a document: the value
// is knowing who has not filed yet, which is why the page renders the whole
// active roster for a month and marks the gaps rather than listing only the
// rows that exist.
//
// The sheet this comes from states the month and the date the batch was
// received once, in a merged cell over the rows. Both are stored per row
// instead: the module keeps the four-module shape that way, and a row remains
// meaningful on its own — filtered, printed, or read out of the audit log —
// without needing a parent row to explain it.
model DtrRecord {
  id                  String   @id @default(cuid())
  officeId            String
  office              Office   @relation(fields: [officeId], references: [id])

  // First day of the month the DTR covers, at UTC midnight — the period, not a
  // date anything happened on. Every query normalises to the 1st, so "July
  // 2026" is one value and not thirty-one near-misses.
  periodMonth         DateTime
  // When the office received the batch for that month ("DATE RECEIVED AUGUST 5,
  // 2026" in the sheet's group cell). Same for every row of a month in practice,
  // but stored per row — see above.
  dateReceived        DateTime?
  dateFiled           DateTime?
  dateSubmittedToHr   DateTime?
  personnelId         String
  personnel           User     @relation(fields: [personnelId], references: [id])
  // The sheet's "Submitted and checked" Yes/No.
  submittedAndChecked Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // One DTR per person per month. This is what makes the roster view's "has
  // this person filed?" a lookup rather than a guess, and what stops the same
  // person being recorded twice for July because two people entered the batch.
  @@unique([officeId, periodMonth, personnelId])
  // The roster view always reads one office's rows for one month.
  @@index([officeId, periodMonth])
}

model IncomingDocument {
  id               String        @id @default(cuid())
  officeId         String
  office           Office        @relation(fields: [officeId], references: [id])

  dateReceived     DateTime
  // Clock time the document was accepted at the desk, "HH:MM" 24-hour.
  // Deliberately NOT folded into dateReceived: it is captured now, but the
  // ARTA calculation still runs off the date alone. Whether a 4:50 PM Friday
  // arrival counts as Friday or Monday is office policy, not an engineering
  // choice — see docs/PHP-TRACKER-ADOPTION.md. Do not wire it in by guessing.
  timeReceived     String?
  // The desk officer who accepted it, distinct from routedTo (who has to act
  // on it) and from the audit trail (who typed the record).
  receivedById     String?
  receivedBy       User?         @relation("IncomingReceivedBy", fields: [receivedById], references: [id])
  origin           DocumentOrigin @default(EXTERNAL)
  // Sending office or agency — "DMW - Ortigas", an employer, an email address.
  originAgency     String?
  // Person who signed the document, as printed on it.
  signatory        String?
  // Type code from src/lib/documentTypeCodes.ts (e.g. "M", "A", "MOM"). Was
  // previously only consumed to build routingNumber and then thrown away,
  // which left the ledger unable to answer "show me every advisory".
  documentType     String?
  // Free-text specification, used only when documentType == "O" (Others).
  // Required at the point of selection rather than optional — unlike
  // Activity.categoryOther, "Others" here is a deliberate pick from the legend
  // and never a default, so an unexplained one would say nothing at all.
  documentTypeOther String?
  routingNumber    String        @unique // e.g. 070126-L-008
  documentTitle    String
  routedTo         IncomingRoutedStaff[]         // Division Chief may route to more than one staff member
  instructions     String?                       // DC's required actions — owned by Division Chief
  complexity       DocComplexity @default(SIMPLE)
  leadTimeDays     Int           @default(3)   // derived from complexity, editable
  dueDate          DateTime?                    // dateReceived + leadTimeDays, computed on save
  numCorrections   Int           @default(0)
  progressRemarks  String?                       // what is happening with it (routing state)
  notes            String?                       // filing state, kept separate from progressRemarks
  dateCompleted    DateTime?
  dcSignOffDate    DateTime?                     // when the Division Chief signed off, distinct from ADAS III record-keeping
  scannedCopyUrl   String?                       // MinIO object key
  filed            Boolean       @default(false)

  outgoingReplies  OutgoingDocument[]            // documents dispatched in response
  linkedActivities IncomingDocumentActivity[]    // the activities this document concerns
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// join table: a document can concern several activities and an activity can
// have several documents — e.g. an advisory, an office order and a terminal
// report all attached to one job fair. Same shape as IncomingRoutedStaff and
// ActivityAssignee; this is the incoming-side counterpart to
// OutgoingDocument.relatedIncomingId.
model IncomingDocumentActivity {
  incomingId String
  incoming   IncomingDocument @relation(fields: [incomingId], references: [id])
  activityId String
  activity   Activity         @relation(fields: [activityId], references: [id])

  @@id([incomingId, activityId])
}

// The outgoing-side counterpart, same shape. The office's own outgoing register
// offers "Link to Tentative Activity(s) (optional, can select more than one)",
// so a dispatch — a terminal report, an invitation letter — can name the job
// fair or seminar it belongs to.
model OutgoingDocumentActivity {
  outgoingId String
  outgoing   OutgoingDocument @relation(fields: [outgoingId], references: [id])
  activityId String
  activity   Activity         @relation(fields: [activityId], references: [id])

  @@id([outgoingId, activityId])
}

model OutgoingDocument {
  id                 String            @id @default(cuid())
  officeId           String
  office             Office            @relation(fields: [officeId], references: [id])

  dateReleased       DateTime
  routingNumber      String            @unique // e.g. 070226-MWPTD-DC-004
  // Type code from src/lib/documentTypeCodes.ts, stored so the ledger can be
  // filtered by type — the incoming side already does this.
  documentType       String?
  // See IncomingDocument.documentTypeOther — same rule.
  documentTypeOther  String?
  documentTitle      String
  instructions       String?

  // Receipt acknowledgement: who took delivery, where, and when. The office's
  // own outgoing register records all four, and they are how it answers "did
  // this actually reach them?" — a released document with no receipt is the
  // thing a clerk chases. All nullable: a document is logged when it leaves,
  // and the receipt comes back later, if at all.
  receivingOffice    String?           // recipient division/office — "PROTECTION", "FAD", "ORD"
  receivedBy         String?           // person who took delivery, free text
  receivedDate       DateTime?         // date the recipient acknowledged it
  receivedTime       String?           // "10:54 PM" — clock time, same shape as IncomingDocument.timeReceived

  progressRemarks    String?
  scannedCopyUrl     String?
  filed              Boolean           @default(false)

  relatedIncomingId  String?
  relatedIncoming    IncomingDocument? @relation(fields: [relatedIncomingId], references: [id])

  linkedActivities   OutgoingDocumentActivity[]  // the activities this dispatch concerns

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Activity {
  id                String    @id @default(cuid())
  officeId          String
  office            Office    @relation(fields: [officeId], references: [id])

  date              DateTime // start date; single-day activities just use this
  endDate           DateTime? // set only for multi-day activities; must be >= date
  activityName      String
  // Defaults to OTHERS so every pre-existing row stays valid without a
  // backfill guess: "unclassified" is honest, a fabricated category is not.
  category          ActivityCategory @default(OTHERS)
  // Free-text specification, used only when category == OTHERS — same shape as
  // Leave.typeOther. Optional rather than required (unlike leave's, where OTHER
  // is a deliberate pick among five named types): OTHERS is this column's
  // default and means "unclassified", so demanding text would tax every
  // activity nobody bothered to categorise.
  categoryOther     String?
  location          String?   // where it happens — "Butuan City Hall"
  remarks           String?
  officeOrderUrl    String?
  memoUrl           String?
  inspectionReportUrl String?

  assignees         ActivityAssignee[]
  linkedIncoming    IncomingDocumentActivity[]
  linkedOutgoing    OutgoingDocumentActivity[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// join table: an activity can have multiple people in charge
model ActivityAssignee {
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@id([activityId, userId])
}

// join table: an incoming document can be routed to multiple staff (the
// Division Chief may need to assign more than one person to the same document)
model IncomingRoutedStaff {
  incomingId String
  incoming   IncomingDocument @relation(fields: [incomingId], references: [id])
  userId     String
  user       User             @relation(fields: [userId], references: [id])

  @@id([incomingId, userId])
}

model Leave {
  id             String    @id @default(cuid())
  officeId       String
  office         Office    @relation(fields: [officeId], references: [id])

  dateFiled      DateTime?
  leaveStart     DateTime
  leaveEnd       DateTime?
  type           LeaveType @default(OTHER)
  typeOther      String?               // free-text specification, used when type == OTHER
  personnelId    String
  personnel      User      @relation(fields: [personnelId], references: [id])
  scannedCopyUrl String?

  createdAt      DateTime  @default(now())
}

model InternalMemo {
  id               String    @id @default(cuid())
  officeId         String
  office           Office    @relation(fields: [officeId], references: [id])

  dateReleased     DateTime
  memorandumNumber Int                   // manually entered; unique within the office, not globally (see routingNumber)
  documentTitle    String
  instructions     String?
  receivedBy       String?
  progressRemarks  String?
  scannedCopyUrl   String?
  filed            Boolean   @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([officeId, memorandumNumber])
}

// Shared template library — deliberately NOT officeId-scoped, unlike every
// other table here: these are standard DMW forms reused by every office,
// not office-specific records. uploadedBy still gives an audit trail.
model FormTemplate {
  id           String   @id @default(cuid())
  number       Int                        // display order, matches the source sheet's "Number" column
  title        String
  fileUrl      String                     // MinIO object key, "shared/forms/..." prefix
  fileName     String                     // original filename, for display/download naming
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Optional but recommended for a government accountability system:
// every create/update/delete on the tables above should write a row here.
model AuditLog {
  id         String   @id @default(cuid())
  officeId   String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // "CREATE" | "UPDATE" | "DELETE" | "READ"
  entityType String   // "IncomingDocument" | "OutgoingDocument" | ... | "File"
  entityId   String
  ipAddress  String?
  details    Json?
  createdAt  DateTime @default(now())
}
