# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://mwpd:change_me_strong_password@localhost:5433/mwpd_tracker

# NextAuth
# http://localhost:3000 is correct for local `npm run dev` (no nginx in front).
# For the docker-compose deploy, set this to the office server's HTTPS address
# behind nginx, e.g. https://192.168.1.50 or https://mwpd.local — nginx.conf
# redirects all plain-HTTP traffic to HTTPS, so this must use https://.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# MinIO (file storage for scanned copies)
MINIO_ROOT_USER=mwpd_admin
MINIO_ROOT_PASSWORD=change_me_strong_password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# Used only by the docker-compose deploy (docker compose up -d --build),
# where MINIO_ENDPOINT is the Docker-internal "minio" hostname the browser
# can't reach. Leave blank for local `npm run dev` — code falls back to
# MINIO_ENDPOINT/MINIO_PORT above, which is correct there since there's no
# reverse proxy in front. In production, set to the office server's HTTPS
# address, e.g. https://192.168.1.50 or https://mwpd.local — nginx.conf
# terminates TLS and proxies /mwpd-scans/ back to MinIO over plain HTTP
# internally, so this must be the https:// address the browser reaches.
#
# Behind nginx the address the browser actually used wins over this value, so
# the server works on more than one address; this is the fallback. What decides
# is whether nginx is there at all, which /api/files/[...key] reads off
# X-Forwarded-Proto — no header, no proxy, so the URL is signed for MinIO
# directly and this must be blank. If you copy this file to .env.local, keep
# the blank line: .env is loaded too, and an omitted key inherits its value.
MINIO_PUBLIC_URL=

# ClamAV (malware scanning for uploads — see docker-compose.yml's clamav
# service and src/lib/clamav.ts). localhost:3310 is correct for local
# `npm run dev`; the docker-compose deploy overrides this to CLAMAV_HOST=clamav.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
